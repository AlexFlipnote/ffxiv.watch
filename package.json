{
  "name": "ffxiv-watch",
  "author": "AlexFlipnote",
  "type": "module",
  "scripts": {
    "dev": "mothwing dev",
    "build": "mothwing build",
    "clean": "mothwing clean",
    "test": "node --test",
    "game-data": "node scripts/sources/xivapi.js && npm run weather-data && npm run gathering-data && npm run sightseeing-data && npm run fishing-data && npm run ocean-fishing-data && npm run crafting-data && npm run vendor-data && npm run pvp-data",
    "weather-data": "node scripts/build/weather.js",
    "gathering-data": "node scripts/build/gathering.js",
    "sightseeing-data": "node scripts/build/sightseeing.js",
    "fishing-data": "node scripts/build/fishing.js",
    "ocean-fishing-data": "node scripts/build/ocean-fishing.js",
    "crafting-data": "node scripts/build/crafting.js",
    "vendor-data": "node scripts/build/vendors.js",
    "pvp-data": "node scripts/build/pvp.js",
    "deploy-images": "node scripts/build-images.js && npx wrangler@4.152.0 deploy -c img/wrangler.jsonc",
    "lodestone-data": "node scripts/build/lodestone.js"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "globals": "^16.5.0",
    "mothwing": "^0.3.3",
    "sass": "^1.93.3",
    "sharp": "0.35.5"
  }
}
