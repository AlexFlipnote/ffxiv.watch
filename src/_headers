# Every link to these has ?v=hash or a hashed name, so a deploy changes the URL and they never go stale
/js/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=31536000, immutable
/rows/*
  Cache-Control: public, max-age=31536000, immutable
/search.json
  Cache-Control: public, max-age=31536000, immutable

# Linked without a hash, but rarely change
/fonts/*
  Cache-Control: public, max-age=604800
/images/maps/*
  Cache-Control: public, max-age=604800
/images/events/*
  Cache-Control: public, max-age=604800
/images/pvp/*
  Cache-Control: public, max-age=604800
/images/ui/*
  Cache-Control: public, max-age=604800

# An icon id's image never changes in the game. Its own folder, as two rules that match join their Cache-Control
/images/game/*
  Cache-Control: public, max-age=31536000, immutable

# frame-ancestors only works as a header, the CSP <meta> can't set it
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
