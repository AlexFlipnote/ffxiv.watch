// img.ffxiv.watch, so the icons don't count against the site's file limit.
{
  "name": "ffxiv-watch-images",
  "compatibility_date": "2026-10-01",
  "routes": [{ "pattern": "img.ffxiv.watch", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "none"
  }
}
